# ==========================================
def startBot(token):
    global bot, bot_thread
    if bot:
        try:
            bot.stop_polling()
        except:
            pass
        bot = None

    # Kiểm tra token hợp lệ cơ bản
    if not re.match(r'^\d{8,10}:[a-zA-Z0-9_-]{35}$', token):
        logging.error("❌ Token Bot không đúng định dạng!")
        return False

    try:
        bot = telebot.TeleBot(token)
        setupBotLogic(bot)
        logging.info('🤖 Bot Telegram đã khởi động thành công!')
        
        if masterWebSocket and masterWebSocket.sock and masterWebSocket.sock.connected:
            masterWebSocket.send(json.dumps({
                'action': 'RES_TELEGRAM_STATUS', 
                'status': 'RUNNING', 
                'channel': currentChannel
            }))
            
        bot_thread = threading.Thread(target=bot.infinity_polling, kwargs={'skip_pending': True})
        bot_thread.daemon = True
        bot_thread.start()
        return True
    except Exception as e:
        logging.error(f"❌ Lỗi khởi động bot: {e}")
        return False

