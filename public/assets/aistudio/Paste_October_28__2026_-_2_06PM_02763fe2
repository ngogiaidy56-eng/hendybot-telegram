                    del userStates[chat_id]
                else:
                    bot_instance.send_message(chat_id, '⚠️ Số tiền nạp tối thiểu là 10.000 VNĐ!')
            return

        # Xử lý nhập SLL / Liên kết tài khoản
        lines = text.split('\n')
        successList = []
        duplicateCount = 0
        errorCount = 0
        limitExceededCount = 0
        MAX_ACCOUNTS = 4

        totalCurrentAccounts = sum([len(arr) for arr in u.get('linkedAccounts', {}).values()])

        for line in lines:
            line = line.strip()
            if not line: continue

            parts = [s.strip() for s in line.split('|')]

            if len(parts) >= 2:
                tk = parts[0]
                mk = parts[1]
                miniCode = parts[2] if len(parts) >= 3 else tk
                brand = parts[3].upper() if len(parts) >= 4 else userStates.get(chat_id, {}).get('brand', 'SC88')

                if brand not in u.get('linkedAccounts', {}):
                    u['linkedAccounts'][brand] = []

                if totalCurrentAccounts >= MAX_ACCOUNTS:
                    limitExceededCount += 1
                    continue

                isDuplicate = any(a['tk'].lower() == tk.lower() for a in u['linkedAccounts'][brand])

                if isDuplicate:
                    duplicateCount += 1
                else:
                    u['linkedAccounts'][brand].append({'tk': tk, 'mk': mk, 'miniCode': miniCode})
