def loadDatabase():
    global users
    with db_lock:
        try:
            if os.path.exists(DB_FILE):
                with open(DB_FILE, 'r', encoding='utf-8') as f:
                    users = json.load(f)
                logging.info(f"✅ Đã tải dữ liệu của {len(users)} khách hàng từ database.json")
            else:
                logging.warning("⚠️ Không tìm thấy database.json, sẽ tạo mới file khi có dữ liệu.")
                users = {}
        except Exception as err:
            logging.error(f"❌ Lỗi khi đọc file database.json: {err}")
            users = {}

def saveDatabase():
    with db_lock:
        try:
            if os.path.exists(DB_FILE):
                backupPath = os.path.join(os.path.dirname(__file__), 'database_backup.json')
                shutil.copy2(DB_FILE, backupPath)
            with open(DB_FILE, 'w', encoding='utf-8') as f:
                json.dump(users, f, indent=4, ensure_ascii=False)
        except Exception as err:
            logging.error(f"❌ Lỗi khi lưu file database.json: {err}")

