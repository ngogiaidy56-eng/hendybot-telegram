# 3. KẾT NỐI WEBSOCKET VỚI TRẠM MẸ
# ==========================================
def connectToMasterHub():
    global masterWebSocket, currentToken, currentAdminId, currentChannel, bot
    wsUrl = 'wss://hendy-server-pro-production.up.railway.app'
    
    def on_message(ws, message):
        global currentToken, currentAdminId, currentChannel, bot
        try:
            data = json.loads(message)
            if 'channel' in data and data['channel'] != currentChannel and not data['action'].startswith('CMD_'):
                return

            if data['action'] == 'CMD_START_TELEGRAM':
                if 'token' in data: currentToken = data['token']
                if 'adminId' in data: currentAdminId = str(data['adminId'])
                if 'channel' in data: currentChannel = data['channel']
                
                isSuccess = startBot(currentToken)
                if isSuccess:
                    sendLogToWeb('✅ Đã bật Bot Telegram từ xa thành công!')
                    
            elif data['action'] == 'CMD_STOP_TELEGRAM':
                if bot:
                    bot.stop_polling()
                    bot = None
                    sendLogToWeb('🛑 Đã TẮT Bot Telegram từ xa!')
                    ws.send(json.dumps({'action': 'RES_TELEGRAM_STATUS', 'status': 'STOPPED', 'channel': currentChannel}))
                    
            elif data['action'] == 'CMD_TELEGRAM_BROADCAST':
                if bot and currentAdminId:
                    try:
                        bot.send_message(currentAdminId, f"📢 *THÔNG BÁO TỪ TRUNG TÂM ĐIỀU KHIỂN:*\n\n{data['message']}", parse_mode='Markdown')
                        sendLogToWeb('📢 Đã gửi loa thành công tới Admin!')
                    except Exception as err:
                        sendLogToWeb(f'❌ Lỗi gửi tin phát loa: {err}')
        except Exception as err:
            logging.error(f"❌ Lỗi parse dữ liệu WebSocket: {err}")

    def on_error(ws, error):
        logging.warning(f"⚠️ WebSocket Error: {error}")

    def on_close(ws, close_status_code, close_msg):
        global masterWebSocket
        masterWebSocket = None
        logging.info("🔌 WebSocket ngắt kết nối. Thử lại sau 5s...")
        time.sleep(5)
        connectToMasterHub()

    def on_open(ws):
        global masterWebSocket
        logging.info('⚡ Bot Python đã kết nối với WebSocket Trạm Mẹ thành công!')
        masterWebSocket = ws
        ws.send(json.dumps({
            'action': 'RES_TELEGRAM_STATUS',
            'status': 'RUNNING' if bot else 'STOPPED',
            'channel': currentChannel
        }))

    ws = websocket.WebSocketApp(wsUrl, on_open=on_open, on_message=on_message, on_error=on_error, on_close=on_close)
    
    def run_ws():
        ws.run_forever()
    
    ws_thread = threading.Thread(target=run_ws)
    ws_thread.daemon = True
    ws_thread.start()

